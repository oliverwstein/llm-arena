# Environment Variables for LLM Pokemon Battle Arena
# Copy this file to .env and fill in your API keys
# Any keys left empty will cause that model to use a random-move bot instead

# OpenAI API Key (for GPT-4o, GPT-4-turbo, etc.)
OPENAI_API_KEY=

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=

# Google API Key (for Gemini models)
GOOGLE_API_KEY=

# xAI API Key (for Grok models)
XAI_API_KEY=

# Together AI API Key (for Llama models via Together)
TOGETHER_API_KEY=

# Groq API Key (for fast inference)
GROQ_API_KEY=

# Mistral API Key
MISTRAL_API_KEY=

# Cohere API Key
COHERE_API_KEY=

# Azure OpenAI (if using Azure-hosted models)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# AWS Bedrock (if using AWS-hosted models)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=

# Ollama (local models - no key needed, just URL)
# Default: http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434
